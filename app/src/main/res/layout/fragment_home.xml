<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fd_bg"
    android:clipToPadding="false"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER (gets top inset in Java) ================= -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:paddingBottom="28dp"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp">

            <LinearLayout
                android:id="@+id/rowLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Location"
                    android:src="@drawable/ic_location"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.85"
                        android:letterSpacing="0.12"
                        android:text="DELIVERING TO"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_circle"
                    android:gravity="center"
                    android:text="🙂"
                    android:textSize="20sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="What are you craving today?"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.9"
                android:text="Order from the best restaurants around you"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <!-- Search -->
            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_search"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_search"
                    app:tint="@color/fd_orange"/>

                <EditText
                    android:id="@+id/searchFood"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search biryani, pizza, burgers…"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/fd_text"
                    android:textColorHint="#A0A0A5"
                    android:textSize="15sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= CHIPS ================= -->
        <HorizontalScrollView
            android:id="@+id/chipScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/chipBiryani" style="@style/FdChip" android:text="🍗  Biryani"/>
                <TextView android:id="@+id/chipPizza" style="@style/FdChip" android:text="🍕  Pizza"/>
                <TextView android:id="@+id/chipBurger" style="@style/FdChip" android:text="🍔  Burger"/>
                <TextView android:id="@+id/chipDosa" style="@style/FdChip" android:text="🥞  Dosa"/>
                <TextView android:id="@+id/chipChinese" style="@style/FdChip" android:text="🥡  Chinese"/>
                <TextView android:id="@+id/chipDesserts" style="@style/FdChip" android:text="🍰  Desserts"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ================= SECTION TITLE ================= -->
        <LinearLayout
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Popular near you"
                android:textColor="@color/fd_text"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Swipe  ›"
                android:textColor="@color/fd_orange"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- ================= RESTAURANTS ================= -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/restaurantRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_slide_right"
            android:overScrollMode="never"
            android:paddingBottom="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"/>

        <!-- ================= PROMO BANNER ================= -->
        <androidx.cardview.widget.CardView
            android:id="@+id/promoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="FREE DELIVERY"
                    android:textColor="@color/fd_orange_light"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="On your first order 🎉"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Use code  WELCOME50"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>