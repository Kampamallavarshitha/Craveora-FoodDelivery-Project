<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/otp_card_white">



    <ImageView
        android:id="@+id/foodImage"

        android:layout_width="0dp"
        android:layout_height="260dp"

        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"

        android:background="@drawable/otp_image_placeholder"
        android:src="@drawable/otp_food_illustration"
        android:padding="24dp"
        android:scaleType="centerInside"

        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"
        />
    <!-- Currently showing a simple vector illustration (otp_food_illustration.xml),
         no photo asset needed. To swap in your own photo instead:
         1) Add it to res/drawable (e.g. food_photo.png)
         2) Replace android:src="@drawable/otp_food_illustration"
            with android:src="@drawable/food_photo"
         3) Remove android:padding and set android:scaleType="centerCrop" -->



    <!-- Title -->

    <TextView
        android:id="@+id/title"

        android:layout_width="280dp"
        android:layout_height="wrap_content"

        android:text="Search for your favorite food near you"

        android:textAlignment="center"

        android:textSize="22sp"

        android:textStyle="bold"

        android:textColor="@color/otp_text_dark"


        app:layout_constraintTop_toBottomOf="@id/foodImage"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="20dp"/>


    <!-- White Bottom Card Section -->

    <LinearLayout

        android:id="@+id/otpLayout"

        android:layout_width="match_parent"

        android:layout_height="300dp"

        android:orientation="vertical"

        android:gravity="center"

        android:padding="25dp"

        android:background="@drawable/bottom_card_bg"

        app:layout_constraintBottom_toBottomOf="parent">


        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Enter OTP"

            android:textSize="26sp"

            android:textStyle="bold"

            android:textColor="@color/otp_text_dark"/>


        <TextView

            android:layout_width="260dp"

            android:layout_height="wrap_content"

            android:text="We have sent a verification code to your mobile number"

            android:textSize="13sp"

            android:textColor="@color/otp_text_muted"

            android:textAlignment="center"

            android:layout_marginTop="8dp"/>


        <!-- OTP Boxes -->

        <LinearLayout

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:layout_marginTop="22dp">


            <EditText
                android:id="@+id/otp1"
                android:layout_width="52dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/otp_brand_purple"
                android:inputType="number"
                android:maxLength="1"
                android:elevation="0dp"
                android:background="@drawable/otp_box"/>


            <EditText
                android:id="@+id/otp2"
                android:layout_width="52dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/otp_brand_purple"
                android:inputType="number"
                android:maxLength="1"
                android:elevation="0dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/otp_box"/>


            <EditText
                android:id="@+id/otp3"
                android:layout_width="52dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/otp_brand_purple"
                android:inputType="number"
                android:maxLength="1"
                android:elevation="0dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/otp_box"/>


            <EditText
                android:id="@+id/otp4"
                android:layout_width="52dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/otp_brand_purple"
                android:inputType="number"
                android:maxLength="1"
                android:elevation="0dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/otp_box"/>

            <EditText
                android:id="@+id/otp5"
                android:layout_width="52dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/otp_brand_purple"
                android:inputType="number"
                android:maxLength="1"
                android:elevation="0dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/otp_box"/>

            <EditText
                android:id="@+id/otp6"
                android:layout_width="52dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/otp_brand_purple"
                android:inputType="number"
                android:maxLength="1"
                android:elevation="0dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/otp_box"/>

        </LinearLayout>


        <Button

            android:id="@+id/verifyBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Verify OTP"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/otp_text_on_purple"
            android:background="@drawable/btn_verify_bg"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:layout_marginTop="25dp"/>


    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>